# WeCom AI bot, long-connection mode: admin console -> 智能机器人 -> your bot ->
# API 模式 -> 长连接. Both values are secrets; this file must stay mode 600.
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# Your own WeCom userid. Owner mode (to-do list, mark done) and owner
# notifications key on it. Find it with:
#   wecom-cli contact users search --keywords <your name>
# You must have sent the bot one message before it can message you (853008).
OWNER_USERID=

# Optional: comma-separated userids allowed to talk to the bot (empty = everyone)
ALLOWED_USERS=

# Optional: model for replies (default: Claude Code's default model)
# CLAUDE_MODEL=sonnet
# Optional: seconds before a reply is abandoned (default 240)
# CLAUDE_TIMEOUT=240

# What you say to the bot in your single chat goes to a Claude Code terminal
# on this Mac: tmux + a terminal window, WITH tools, auto mode, your normal
# Claude Code settings.
# Optional: the directory offered for a new session; relative answers resolve
# against it (default: your home directory)
# TASK_BASE_DIR=~/code
# Optional: model for that terminal (default: the model in your Claude Code settings)
# TASK_MODEL=opus
